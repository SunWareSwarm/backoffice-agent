# Copia este archivo a .env y completa tus claves. NUNCA subas el .env real.
# Los comentarios van en su propia línea (no al final de un valor): Docker Compose y Python los leen igual así.

# --- Modelo de chat (el proveedor y el modelo se eligen aquí, nunca en el código) ---
# Proveedor: google, openai o anthropic
LLM_PROVIDER=google
# Nombre exacto del modelo, tal como lo da tu proveedor. Para ver los que puede usar tu clave: python -m scripts.listar_modelos
LLM_MODEL=

# --- Modelo de respaldo (opcional pero recomendado en el plan gratuito) ---
# Si el modelo principal responde 503 (saturado) o 429 (cuota) tras los reintentos, se usa este, del mismo proveedor.
# Elige uno distinto al principal.
# LLM_FALLBACK_MODEL=

# --- Modelo de embeddings (puede ser de un proveedor distinto al del chat) ---
# Proveedor: google u openai
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
# Opcional. Si lo cambias, hay que volver a indexar el RAG (python -m scripts.arrancar --reiniciar).
# EMBEDDING_DIMENSIONS=

# --- Claves (solo la del proveedor que uses) ---
# GEMINI_API_KEY también se acepta como alias de GOOGLE_API_KEY.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Política del cliente de texto ---
# Tiempo máximo por llamada, en segundos.
LLM_TIMEOUT_SECONDS=60
# Reintentos ante fallos pasajeros (saturación, cuota o red).
LLM_MAX_RETRIES=3
# Espera inicial en segundos; se duplica en cada reintento (2, 4 y 8).
LLM_RETRY_BASE_SECONDS=2.0

# --- RAG ---
CHROMA_PATH=data/chroma
RAG_TOP_K=4
# Modo de búsqueda: vectorial, bm25 o hibrido. El híbrido fue el de mejor desempeño en la evaluación.
RAG_MODO=hibrido

# --- Datos simulados ---
SQLITE_PATH=data/tienda.db
# La fecha «de hoy» de la tienda ficticia. Déjala así para que las cifras coincidan con la documentación.
# FECHA_SIMULADA=2026-11-03

# --- API y Redis ---
REDIS_URL=redis://localhost:6379/0
# Segundos máximos por ejecución antes de marcar el trabajo como FAILED.
# JOB_TIMEOUT_SECONDS=300

# --- Observabilidad (LangSmith): con estas variables, las trazas se envían solas ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=backoffice-agent
